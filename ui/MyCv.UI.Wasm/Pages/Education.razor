@using MyCv.UI.Wasm.Services
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Shared> SharedLocalizer
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Home> Localizer
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Education> EducationLocalizer
@inject IThemeService ThemeService
@inject IConfiguration Configuration

<MudPaper Class="py-8" Square="true" Elevation="0" id="education">
    <MudContainer>
        @* Header *@
        <MudContainer Class="@Style.LargeBottomMargin">
            <MudText Typo="Typo.h4" Align="Align.Center">@SharedLocalizer["Education"]</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center">@EducationLocalizer["Introduction"]</MudText>
        </MudContainer>

        @* Main degrees *@
        <MudContainer Class="@Style.LargeBottomMargin">
            <MudGrid>
                @foreach (var degree in _degrees)
                {
                    <MudItem xs="12" md="4">
                        <MudCard Class="edu-card h-100 rounded-lg" Elevation="6" Style="@($"border-top: 4px solid {degree.AccentColor}; --card-accent: {degree.AccentColor}")">
                            <MudCardContent Class="px-4 pt-4 pb-4">
                                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                                    <MudAvatar Style="background:white; border:1px solid var(--mud-palette-divider); width:80px; height:80px;">
                                        <MudImage Src="@degree.Image" Alt="@degree.Institution"
                                                  Width="68" Height="68" ObjectFit="ObjectFit.Contain" />
                                    </MudAvatar>
                                    <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Primary">
                                            <strong>@degree.Name</strong>
                                        </MudText>
                                        <MudText Typo="Typo.body2" Align="Align.Center">@degree.Specialty</MudText>
                                        <MudText Typo="Typo.caption" Align="Align.Center" Class="text-uppercase mt-1">
                                            @(new MarkupString(degree.Institution))
                                        </MudText>
                                    </MudStack>
                                    <MudStack Row Spacing="1">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@degree.Year</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@degree.Score</MudChip>
                                    </MudStack>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>

        @* Certifications *@
        <MudContainer>
            <MudGrid>
                @* Microsoft *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="2" Square Class="pa-4" Style="border-left:2px solid #00A4EF; background-color: #00A4EF15">
                        @* Header *@
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                            <MudIcon Icon="@Icons.Custom.Brands.Microsoft" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1"><strong>@SharedLocalizer["Microsoft"]</strong></MudText>
                        </MudStack>
                        @* Certifications *@
                        <MudGrid>
                            @foreach (var certification in _microsoftCertifications)
                            {
                                <MudItem xs="12" md="6">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <div class="cert-badge">
                                            <MudLink Href="@certification.Url" Target="_blank">
                                                <MudImage Src="@certification.Image" Alt="@certification.Title" Width="56" Height="56" ObjectFit="ObjectFit.Contain" />
                                            </MudLink>
                                        </div>
                                        <MudText Typo="Typo.body2" Align="Align.Center"><strong>@(new MarkupString(certification.CertificationId))</strong></MudText>
                                        <MudText Typo="Typo.caption" Align="Align.Center">@(new MarkupString(certification.Title))</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@certification.Year</MudChip>
                                    </MudStack>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudPaper>
                </MudItem>
                @* Language *@
                <MudItem xs="12" md="6">
                    <MudContainer>
                        @* Header *@
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Translate" />
                            <MudText Typo="Typo.subtitle1"><strong>@SharedLocalizer["Languages"]</strong></MudText>
                        </MudStack>
                        <MudDivider Style="@(ThemeService.IsDarkMode? "border-color:rgba(255, 255, 255, 0.5)" : "border-color:rgba(0, 0, 0, 0.5)")" Class="mb-2" />
                        @* Certifications *@
                        <MudStack Spacing="1">
                            @foreach (var certification in _languageCertifications)
                            {
                                <MudPaper Elevation="0" Class="h-100 pa-2">
                                    <MudStack Spacing="1">
                                        <MudText><strong>@certification.Language</strong></MudText>
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                                            <div class="cert-badge">
                                                <MudImage Src="@certification.Image" Alt="@certification.Name" Width="56" Height="56" ObjectFit="ObjectFit.Contain" />
                                            </div>
                                            <MudStack Spacing="1" Class="flex-grow-1" Style="min-width:0">
                                                <MudText Typo="Typo.body2">@certification.Name</MudText>
                                                <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@certification.Year</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@certification.Score</MudChip>
                                                </MudStack>
                                            </MudStack>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudContainer>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudContainer>
</MudPaper>

<style>
    .edu-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease !important;
        overflow: hidden;
    }

        .edu-card.active {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.15), 0 0 0 2px var(--card-accent), 0 0 16px 4px var(--card-accent) !important;
        }
    /* Keep hover only for desktop */
    @@media (hover: hover) {
        .edu-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.15), 0 0 0 2px var(--card-accent), 0 0 16px 4px var(--card-accent) !important;
        }
    }

    .cert-badge {
        background: white;
        border-radius: 6px;
        padding: 10px;
    }
</style>

@code {
    private record Degree(int Year, string Image, string Name, string Specialty, string Institution, string Score, string AccentColor);
    private record LanguageCertification(string Language, int Year, string Image, string Name, string Score);
    private record MicrosoftCertification(int Year, string Image, string CertificationId, string Title, string Url);
    private List<Degree> _degrees = new();
    private List<LanguageCertification> _languageCertifications = new();
    private List<MicrosoftCertification> _microsoftCertifications = new();

    protected override void OnInitialized()
    {
        _degrees = new()
        {
            new(Year: 2014,
                Image: "images/degrees/tlcom_physique_strasbourg_logo.webp",
                Name: EducationLocalizer["EducationEngineeringDegree"],
                Specialty: EducationLocalizer["EducationEngineeringDegreeTitle"],
                Institution: "Télécom Physique Strasbourg<br>" + EducationLocalizer["EducationPartnerOf", "Institut Mines-Télécom (IMT)"],
                Score: EducationLocalizer["EducationRanked", "3e/79"],
                AccentColor: "#1976D2"),
            new(Year: 2014,
                Image: "images/degrees/universite_de_strasbourg_logo.webp",
                Name: EducationLocalizer["EducationMaster"],
                Specialty: EducationLocalizer["EducationMasterScienceTitle"],
                Institution: "Université de Strasbourg",
                Score: EducationLocalizer["EducationWithHighHonours"],
                AccentColor: "#00897B"),
            new(Year: 2015,
                Image: "images/degrees/em_strasbourg_logo.webp",
                Name: EducationLocalizer["EducationMaster"],
                Specialty: EducationLocalizer["EducationMasterBusinessTitle"],
                Institution: "EM Strasbourg Business School",
                Score: EducationLocalizer["EducationWithHighHonours"],
                AccentColor: "#F9A825")
        };
        _languageCertifications = new()
        {
            new(Language: SharedLocalizer["English"],
                Year: 2013,
                Image: "images/certifications/toeic.webp",
                Name: "TOEIC",
                Score: EducationLocalizer["EducationScore", "880/990"]),
            new(Language: SharedLocalizer["Japanese"],
                Year: 2025,
                Image: "images/certifications/jlpt.webp",
                Name: "JLPT - N5",
                Score: EducationLocalizer["EducationScore", "107"]),
        };
        _microsoftCertifications = new()
        {
            new(Year: 2026,
                Image: "images/certifications/ai-200.svg",
                CertificationId:  "AI-200",
                Title: "Azure AI Cloud Developer Associate<br>(ex AZ-204)",
                Url: "https://learn.microsoft.com/api/credentials/share/en-us/ValrianVerona-3413/DDF7823793B99F1D?sharingId=BF7E5DC00880FEE2"),
            new(Year:2026,
                Image: "images/certifications/az-900.svg",
                CertificationId: "AZ-900",
                Title: "Azure Fundamentals",
                Url: "https://learn.microsoft.com/api/credentials/share/en-us/ValrianVerona-3413/839FE6E06DE2BDAE?sharingId=BF7E5DC00880FEE2"),
        };

        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
