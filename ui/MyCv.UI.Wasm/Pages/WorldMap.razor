@inject IJSRuntime JS

@* The SVG (about 1.2 MB of path data) is a static file loaded only when the map gets close to the viewport,
   so it is not compiled into the app assembly that every visitor downloads. See wwwroot/scripts/map.js. *@
<div class="world-map p-2 p-lg-4" @ref="_container" role="img" aria-label="World map of visited countries"></div>

<style>
    .world-map svg {
        width: 100%;
        height: auto;
        max-width: 100%;
        display: block; /* removes inline SVG whitespace */
    }

        .world-map svg path {
            fill: rgba(255, 255, 255, 0.08);
            stroke: rgba(255, 255, 255, 0.15);
            stroke-width: 0.5;
        }

            .world-map svg path.visited {
                fill: #60a5fa; /* blue matching the travel icon */
            }

                .world-map svg path.visited:hover {
                    fill: #93c5fd;
                    cursor: pointer;
                    transition: fill 0.2s ease;
                }

    .map-tooltip {
        position: fixed;
        display: none;
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        border: 1px solid var(--mud-palette-divider);
        border-radius: 4px;
        padding: 4px 10px;
        font-size: 12px;
        pointer-events: none;
        z-index: 9999;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
</style>

@code {
    private ElementReference _container;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("loadWorldMap", _container, "images/world-map.svg");
        }
    }
}
