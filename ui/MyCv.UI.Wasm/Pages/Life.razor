@using MyCv.UI.Wasm.Services
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Home> Localizer
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Life> LifeLocalizer
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Shared> SharedLocalizer
@inject IThemeService ThemeService
@inject IConfiguration Configuration

<MudPaper Class="py-8 section-tinted" id="life">
    <MudContainer>
        @* Header *@
        <MudContainer Class="@Style.LargeBottomMargin">
            <MudText Typo="Typo.h4" Align="Align.Center">@SharedLocalizer["PersonalLife"]</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center">@LifeLocalizer["Introduction"]</MudText>
        </MudContainer>

        @* Panel 1 – Travel *@
        <div class="life-panel travel-panel @Style.LargeBottomMargin">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <WorldMap/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudStack Spacing="4" Class="pa-4">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.TravelExplore" Style="color:#60a5fa" />
                            <MudText Typo="Typo.overline" Style="color:rgba(255,255,255,0.5); letter-spacing:0.1em">
                                @LifeLocalizer["Travel"]
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body1" Style="color:white">
                            @LifeLocalizer["TravelInterest"]
                        </MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </div>

        @* Panel 2 – Piano *@
        <div class="life-panel piano-panel">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudStack Spacing="4" Class="pa-4">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.MusicNote" Style="color:#c084fc" />
                            <MudText Typo="Typo.overline" Style="color:rgba(255,255,255,0.5); letter-spacing:0.1em">
                                @LifeLocalizer["Piano"]
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body1" Style="color:white">
                            @LifeLocalizer["PianoInterest"]
                        </MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudCarousel @ref="_carousel"
                                 Style="height: min(420px, 90vw);"
                                 AutoCycle="true"
                                 ShowArrows="false"
                                 ShowBullets="false"
                                 TData="object"
                                 SelectedIndexChanged="OnSlideChanged">
                        @foreach (var piece in PianoPieces)
                        {
                            <MudCarouselItem>
                                <div class="piano-slide" style="background-image: url('@piece.Image')">
                                    <div class="piano-overlay">
                                        <MudStack Spacing="1" Class="piano-caption">
                                            <MudText Typo="Typo.h5" Style="color:white; font-weight:700">
                                                @piece.Composer
                                            </MudText>
                                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.75)">
                                                @piece.Title
                                            </MudText>
                                        </MudStack>
                                        @* Manual dots *@
                                        <MudStack Row Justify="Justify.Center" Spacing="1" Class="piano-dots">
                                            @for (int i = 0; i < PianoPieces.Count; i++)
                                            {
                                                var idx = i;
                                                <div class="@($"piano-dot {(idx == _activeIndex ? "active" : "")}")"
                                                     @onclick="() => _carousel!.MoveTo(idx)"></div>
                                            }
                                        </MudStack>
                                    </div>
                                </div>
                            </MudCarouselItem>
                        }
                    </MudCarousel>
                </MudItem>
            </MudGrid>
        </div>
    </MudContainer>
</MudPaper>

<style>
    /* Shared panel style */
    .life-panel {
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    /* Travel — deep navy */
    .travel-panel {
        background: linear-gradient(135deg, #0f172a, #1e3a5f);
    }


    /* Piano — near black with warm tint */
    .piano-panel {
        background: linear-gradient(135deg, #0c0a09, #1c1917);
    }

    /* Piano slide: full bg image + overlay */
    .piano-slide {
        height: 100%;
        width: 100%;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center top;
        position: relative;
    }

    .piano-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 24px;
        gap: 12px;
    }

    .piano-caption {
        animation: fade-up 0.5s ease;
    }

    @@keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Custom dots */
    .piano-dots {
        padding-bottom: 4px;
    }

    .piano-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.3);
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .piano-dot.active {
            background: white;
            transform: scale(1.3);
        }
</style>

@code {
    private record PianoPiece(string Title, string Composer, string Image);

    private MudCarousel<object>? _carousel;
    private int _activeIndex = 0;

    private void OnSlideChanged(int index) => _activeIndex = index;

    private List<PianoPiece> PianoPieces = new()
    {
        new("Piano Concerto No. 2 in C minor, Op. 18 (1st mvt)", "Sergei Rachmaninov", "images/rachmaninov.jpg"),
        new("Etude in D-sharp minor, Op. 8, No. 12", "Alexander Scriabin", "images/scriabin.jpg"),
        new("Waltz in C-sharp minor, Op. 64, No. 2", "Frédéric Chopin", "images/chopin.jpeg"),
        new("Sonatine", "Maurice Ravel", "images/ravel.jpg"),
        new("Piano Sonata No. 14 in C-sharp minor, Op. 27, No. 2 - \"Moonlight Sonata\" (3rd mvt)", "Ludwig van Beethoven", "images/beethoven.jpg")
    };
}
