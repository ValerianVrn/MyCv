@using MyCv.UI.Wasm.Shared
@using MyCv.UI.Wasm.Shared.AppBar
@using MyCv.UI.Wasm.Shared.Content
@inherits LayoutComponentBase
@inject IJSRuntime JS

@* Required *@
<ThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    @* Top bar *@
    <AppBar />
    @* Lateral menu of the page content *@
    <Menu @ref="_menu" />
    @* Page content *@
    <MudMainContent data-bs-spy="scroll" data-bs-target="#content-menu">
        @* So that header and sections can call methods of this component *@
        <CascadingValue Value="_menu">
            @Body
        </CascadingValue>
    </MudMainContent>
    <MudDivider />
    <Footer />
</MudLayout>

@code {
    private Menu? _menu;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Scroll spy activates menu items when scrolling. Reuses a single instance and refreshes
        // its targets, since menu sections can be registered after the first render.
        await JS.InvokeVoidAsync("refreshScrollSpy");
    }
}
