@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Layout.AppBar> Localizer

<MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
               aria-label="@(IsDarkMode ? Localizer["SwitchToLight"] : Localizer["SwitchToDark"])"
               Color="@(IsDarkMode ? Color.Inherit : Color.Dark)"
               OnClick="OnToggle" />

@code {
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
