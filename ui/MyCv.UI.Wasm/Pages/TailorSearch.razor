@implements IDisposable
@using MyCv.UI.Wasm.Exceptions
@using MyCv.UI.Wasm.Shared.AppBar
@inject ITailorService TailorApi
@inject ILogger<TailorSearch> Logger
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Home> Localizer
@inject IThemeService ThemeService

@* Search bar *@
<MudPaper Class="@(ThemeService.IsDarkMode ? "tailor-wrap-dark pa-4 mt-6" : "tailor-wrap-light pa-4 mt-6")" Elevation="0">
    <MudStack Spacing="2" AlignItems="AlignItems.Center">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Warning" />
            <MudText Typo="Typo.h6">
                @Localizer["TailorTitle"]
            </MudText>
        </MudStack>
        <MudTextField @bind-Value="_input"
                      Immediate
                      Label="@Localizer["TailorJobOffer"]"
                      Variant="Variant.Outlined"
                      MaxLines="8"
                      AutoGrow
                      FullWidth="true"
                      Disabled="_loading"
                      MaxLength="@TailorService.MaxInputLength"
                      Counter="@TailorService.MaxInputLength"
                      HelperText="@Localizer["TailorHint"]" />
        @* Examples: fill the field (no auto-submit) so recruiters see what to type. *@
        <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Localizer["TailorExamples"]</MudText>
            @foreach (var key in ExampleKeys)
            {
                var example = Localizer[key].Value;
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                         Disabled="_loading" OnClick="@(() => _input = example)">@example</MudChip>
            }
        </MudStack>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(string.IsNullOrWhiteSpace(_input) || _loading)">
            @if (_loading)
            {
                <MudProgressCircular Class="me-2" Indeterminate Color="Color.Primary" Size="Size.Small" />
                @Localizer["TailorAnalysing"]
            }
            else
            {
                @Localizer["TailorAnalyse"]
            }
        </MudButton>
        <MudText Typo="Typo.caption" Class="mud-text-secondary" Align="Align.Center">
            @Localizer["TailorPrivacy"]
        </MudText>
    </MudStack>
</MudPaper>

@* Result *@
@if (_result is not null && !_loading)
{
    <MudCard Class="tailor-card mt-4" Elevation="4" Outlined>

        @* Accent bar matching case *@
        <div class="tailor-accent @CaseAccentClass"></div>

        @* Content *@
        <MudCardContent Class="pa-4 position-relative">

            @* Close/reset button *@
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="Reset"
                           Class="position-absolute top-0 end-0 mt-2 me-2" />

            <MudStack Spacing="3">

                @* Header *@
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                    <MudStack Row Spacing="0">
                        @* Label *@
                        <MudText Typo="Typo.h6">@_result.MatchLabel</MudText>
                    </MudStack>
                    @* Stars *@
                    <MudRating ReadOnly="true"
                               SelectedValue="_result.Stars"
                               MaxValue="5"
                               Color="Color.Warning" />
                </MudStack>

                @* Humor *@
                <MudAlert Severity="@SeverityResult" Variant="Variant.Outlined" Dense="true" Icon="@IconResult">
                    @_result.Humor
                </MudAlert>

                @* Why match *@
                @if (_result.WhyMatch.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Color="Color.Primary"><strong>@Localizer["TailorWhyMatch"]</strong></MudText>
                        <MudStack Spacing="1">
                            @foreach (var s in _result.WhyMatch)
                            {
                                <MudStack Row AlignItems="AlignItems.Start" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Typo="Typo.body2">@s</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudStack>
                }

                @* Skill bridges *@
                @if (_result.SkillBridges.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Color="Color.Secondary"><strong>@Localizer["TailorSkillBridge"]</strong></MudText>
                        @foreach (var b in _result.SkillBridges)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Style="text-decoration:line-through; opacity:0.5">@b.Asked</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2"><strong>@b.Have</strong></MudText>
                            </MudStack>
                        }
                    </MudStack>
                }

                @* Bonus skills *@
                @if (_result.BonusSkills.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Color="Color.Success"><strong>@Localizer["TailorBonus"]</strong></MudText>
                        @foreach (var s in _result.BonusSkills)
                        {
                            <MudStack Row AlignItems="AlignItems.Start" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Success" />
                                <MudText Typo="Typo.body2">@s</MudText>
                            </MudStack>
                        }
                    </MudStack>
                }

                @* Pitch *@
                @if (!string.IsNullOrEmpty(_result.Pitch))
                {
                    <MudPaper Class="pa-3 rounded-lg" Elevation="0" Style="background:var(--mud-palette-background-gray)">
                        <MudText Typo="Typo.body2" Style="font-style:italic">@_result.Pitch</MudText>
                    </MudPaper>
                }

                <MudDivider />

                @* Contact *@
                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_result.ContactCopy</MudText>
                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                        <SocialItems />
                    </MudStack>
                </MudStack>

            </MudStack>
        </MudCardContent>
    </MudCard>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
        @_error
    </MudAlert>
}

<style>
    .tailor-wrap-dark {
        border: 1px solid white;        
        border-radius: 12px !important;
        background-color: #302b63;
    }

    .tailor-wrap-light {
        border: 1px solid #302b63;
        border-radius: 12px !important;
        background-color: color-mix(in srgb, #302b63 15%, white);
    }

    .tailor-card {
        overflow: hidden;
        animation: slide-up 0.6s ease;
    }

    .tailor-accent {
        height: 6px;
    }

        .tailor-accent.match-strong {
            background: var(--mud-palette-success);
        }

        .tailor-accent.match-partial {
            background: var(--mud-palette-warning);
        }

        .tailor-accent.match-none {
            background: var(--mud-palette-error);
        }

    @@keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private string _input = "";
    private bool _loading = false;
    private TailorResult? _result = null;
    private CancellationTokenSource _cts = new();
    private string? _error = null;
    private static readonly string[] ExampleKeys = ["TailorExample1", "TailorExample2", "TailorExample3"];

    /// <summary>
    /// Covers Function cold start + Gemini latency + server-side retries.
    /// </summary>
    private static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(45);
    private string CaseAccentClass => _result?.Case switch
    {
        3 => "match-strong",
        2 => "match-partial",
        _ => "match-none"
    };
    private Severity SeverityResult => _result?.Case switch
    {
        3 => Severity.Success,
        2 => Severity.Warning,
        _ => Severity.Error
    };
    private string? IconResult => _result?.Case switch
    {
        3 => Icons.Material.Filled.SentimentVerySatisfied,
        2 => Icons.Material.Filled.SentimentSatisfiedAlt,
        _ => Icons.Material.Filled.SentimentDissatisfied
    };

    private async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_input) || _loading) return;
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        _result = null;
        _loading = true;
        StateHasChanged();
        try
        {
            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
            timeout.CancelAfter(RequestTimeout);
            _result = await TailorApi.TailorAsync(_input.Trim(), timeout.Token);
            if (_result is null)
            {
                _error = Localizer["TailorUnavailable"];
            }
        }
        catch (TailorRateLimitedException)
        {
            _error = Localizer["TailorRateLimited"];
        }
        catch (TailorUnavailableException ex)
        {
            Logger.LogWarning(ex, "Tailor unavailable");
            _error = Localizer["TailorUnavailable"];
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Cancelled by the visitor (reset) or component disposal: nothing to show.
        }
        catch (OperationCanceledException)
        {
            // Client-side timeout.
            _error = Localizer["TailorUnavailable"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected Tailor error");
            _result = null;
            _error = Localizer["TailorUnavailable"];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

    private void Reset()
    {
        _result = null;
        _error = null;
        _input = "";
        _cts.Cancel();
    }
}
