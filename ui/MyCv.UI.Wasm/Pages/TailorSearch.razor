@using MyCv.UI.Wasm.Exceptions
@using MyCv.UI.Wasm.Shared.AppBar
@inject ITailorService TailorService
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Home> Localizer;

@* Search bar *@
<MudPaper Class="tailor-wrap pa-4 mt-6" Elevation="0">
    <MudStack Spacing="2" AlignItems="AlignItems.Center">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Color="Color.Primary">
                @Localizer["TailorTitle"]
            </MudText>
        </MudStack>
        <MudTextField @bind-Value="_input"
                      Immediate
                      Label="@Localizer["TailorJobOffer"]"
                      Variant="Variant.Outlined"
                      MaxLines="8"
                      AutoGrow
                      FullWidth="true"
                      Disabled="_loading"
                      HelperText="@Localizer["TailorHint"]" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(string.IsNullOrWhiteSpace(_input) || _loading)">
            @if (_loading)
            {
                <MudProgressCircular Class="me-2" Indeterminate Color="Color.Primary" Size="Size.Small" />
                @Localizer["TailorAnalysing"]
            }
            else
            {
                @Localizer["TailorAnalyse"]
            }
        </MudButton>
    </MudStack>
</MudPaper>

@* Result *@
@if (_result is not null && !_loading)
{
    <MudCard Class="tailor-card mt-4" Elevation="4" Outlined>

        @* Accent bar matching case *@
        <div class="tailor-accent @CaseAccentClass"></div>

        @* Content *@
        <MudCardContent Class="pa-4 position-relative">

            @* Close/reset button *@
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="Reset"
                           Class="position-absolute top-0 end-0 mt-2 me-2" />

            <MudStack Spacing="3">

                @* Header *@
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                    <MudStack Row Spacing="0">
                        @* Label *@
                        <MudText Typo="Typo.h6">@_result.MatchLabel</MudText>
                    </MudStack>
                    @* Stars *@
                    <MudRating ReadOnly="true"
                               SelectedValue="_result.Stars"
                               MaxValue="5"
                               Color="Color.Warning" />
                </MudStack>

                @* Humor *@
                <MudAlert Severity="@SeverityResult" Variant="Variant.Outlined" Dense="true" Icon="@IconResult">
                    @_result.Humor
                </MudAlert>

                @* Why match *@
                @if (_result.WhyMatch.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Color="Color.Primary"><strong>@Localizer["TailorWhyMatch"]</strong></MudText>
                        <MudStack Spacing="1">
                            @foreach (var s in _result.WhyMatch)
                            {
                                <MudStack Row AlignItems="AlignItems.Start" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Typo="Typo.body2">@s</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudStack>
                }

                @* Skill bridges *@
                @if (_result.SkillBridges.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Color="Color.Secondary"><strong>@Localizer["TailorSkillBridge"]</strong></MudText>
                        @foreach (var b in _result.SkillBridges)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Style="text-decoration:line-through; opacity:0.5">@b.Asked</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2"><strong>@b.Have</strong></MudText>
                            </MudStack>
                        }
                    </MudStack>
                }

                @* Bonus skills *@
                @if (_result.BonusSkills.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Color="Color.Success"><strong>@Localizer["TailorBonus"]</strong></MudText>
                        @foreach (var s in _result.BonusSkills)
                        {
                            <MudStack Row AlignItems="AlignItems.Start" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Success" />
                                <MudText Typo="Typo.body2">@s</MudText>
                            </MudStack>
                        }
                    </MudStack>
                }

                @* Pitch *@
                @if (!string.IsNullOrEmpty(_result.Pitch))
                {
                    <MudPaper Class="pa-3 rounded-lg" Elevation="0" Style="background:var(--mud-palette-background-gray)">
                        <MudText Typo="Typo.body2" Style="font-style:italic">@_result.Pitch</MudText>
                    </MudPaper>
                }

                <MudDivider />

                @* Contact *@
                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_result.ContactCopy</MudText>
                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                        <SocialItems />
                    </MudStack>
                </MudStack>

            </MudStack>
        </MudCardContent>
    </MudCard>
}

@if (_unavailable)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
        @Localizer["TailorUnavailable"]
    </MudAlert>
}

<style>
    .tailor-wrap {
        border: 1px solid var(--mud-palette-primary);
        border-radius: 12px !important;
        background: var(--mud-palette-primary-hover) !important;
    }

    .tailor-card {
        overflow: hidden;
        animation: slide-up 0.6s ease;
    }

    .tailor-accent {
        height: 6px;
    }

        .tailor-accent.match-strong {
            background: var(--mud-palette-success);
        }

        .tailor-accent.match-partial {
            background: var(--mud-palette-warning);
        }

        .tailor-accent.match-none {
            background: var(--mud-palette-error);
        }

    @@keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private string _input = "";
    private bool _loading = false;
    private TailorResult? _result = null;
    private CancellationTokenSource _cts = new();
    private bool _unavailable = false;
    private string CaseAccentClass => _result?.Case switch
    {
        3 => "match-strong",
        2 => "match-partial",
        _ => "match-none"
    };
    private Severity SeverityResult => _result?.Case switch
    {
        3 => Severity.Success,
        2 => Severity.Warning,
        _ => Severity.Error
    };
    private string? IconResult => _result?.Case switch
    {
        3 => Icons.Material.Filled.SentimentVerySatisfied,
        2 => Icons.Material.Filled.SentimentSatisfiedAlt,
        _ => Icons.Material.Filled.SentimentDissatisfied
    };

    private async Task Submit()
    {
        _unavailable = false;

        if (string.IsNullOrWhiteSpace(_input) || _loading) return;
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _result = null;
        _loading = true;
        StateHasChanged();
        try
        {
            _result = await TailorService.TailorAsync(_input.Trim(), _cts.Token);
        }
        catch (TailorUnavailableException)
        {
            _unavailable = true;
        }
        catch (OperationCanceledException) { }
        catch { _result = null; }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void Reset()
    {
        _result = null;
        _input = "";
        _cts.Cancel();
    }

    public void Dispose() => _cts.Cancel();
}
