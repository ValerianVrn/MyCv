@using MyCv.UI.Wasm.Layout
@using MyCv.UI.Wasm.Services
@inject IDialogService DialogService
@inject ILocalizationService LocalizationService

<MudMenu Icon="@Icons.Material.Filled.Language">
    @foreach (var language in _languages)
    {
        var isActive = IsActive(language.CultureInfo);
        <MudMenuItem OnClick="@(()=>SetLanguage(language.CultureInfo))" aria-current="@(isActive ? "true" : null)">
            <span class=@language.IconClass></span> @language.Name
            @if (isActive)
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" Class="ml-2" Style="vertical-align: middle" />
            }
        </MudMenuItem>
    }
</MudMenu>

@code {

    private record Language(CultureInfo CultureInfo, string IconClass, string Name);

    private List<Language> _languages = new()
    {
        new(MyCv.UI.Wasm.Services.LocalizationService.English, "fi fi-gb mr-2", "English"),
        new(MyCv.UI.Wasm.Services.LocalizationService.French, "fi fi-fr mr-2", "Français"),
        new(MyCv.UI.Wasm.Services.LocalizationService.Japanese, "fi fi-jp mr-2", "日本語")
    };

    private async Task SetLanguage(CultureInfo cultureInfo)
    {
        if (cultureInfo == MyCv.UI.Wasm.Services.LocalizationService.Japanese)
        {
            var options = new DialogOptions { CloseOnEscapeKey = true };

            _ = await DialogService.ShowAsync<JapaneseDialog>(null, options);
        }
        else
        {
            LocalizationService.SetCulture(cultureInfo);
            await LocalizationService.ApplySelectedCultureAsync();
        }
    }

    private static bool IsActive(CultureInfo cultureInfo)
    {
        return string.Equals(CultureInfo.CurrentUICulture.Name, cultureInfo.Name, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized()
    {
        LocalizationService.SetCulture(CultureInfo.CurrentCulture);
    }
}
