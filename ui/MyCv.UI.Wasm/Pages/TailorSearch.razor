@using MyCv.UI.Wasm.Exceptions
@inject ITailorService TailorService
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Home> Localizer;

@* Search bar *@
<MudStack Spacing="2">
    <MudTextField @bind-Value="_input"
                  Placeholder="@Localizer["TailorPlaceholder"]"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                  AdornmentColor="Color.Primary"
                  OnAdornmentClick="Submit"
                  OnKeyDown="OnKeyDown"
                  Disabled="_loading"
                  FullWidth="true"
                  Class="tailor-search" />
    <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
        @Localizer["TailorHint"]
    </MudText>
</MudStack>

@* Result card — slides in below *@
@if (_loading)
{
    <MudCard Class="tailor-card mt-4" Elevation="4">
        <MudCardContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["TailorLoading"]</MudText>
            </MudStack>
        </MudCardContent>
    </MudCard>
}

@if (_result is not null && !_loading)
{
    <MudCard Class="tailor-card mt-4" Elevation="4">

        @* Gradient accent bar matching case *@
        <div class="tailor-accent @CaseAccentClass"></div>

        <MudCardContent Class="pa-4">
            <MudStack Spacing="3">

                @* Header *@
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="letter-spacing:0.08em; text-transform:uppercase">
                            Tailored for you
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   OnClick="Reset" />
                </MudStack>

                @* Stars + label *@
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudRating ReadOnly="true"
                               SelectedValue="_result.Stars"
                               MaxValue="5"
                               Color="Color.Warning" />
                    <MudText Typo="Typo.subtitle2">@_result.MatchLabel</MudText>
                </MudStack>

                @* Humor *@
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.EmojiEmotions">
                    @_result.Humor
                </MudAlert>

                @* Why match *@
                @if (_result.WhyMatch.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Why he matches</MudText>
                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                            @foreach (var s in _result.WhyMatch)
                            {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@s</MudChip>
                            }
                        </MudStack>
                    </MudStack>
                }

                @* Skill bridges *@
                @if (_result.SkillBridges.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">What transfers</MudText>
                        @foreach (var b in _result.SkillBridges)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.body2" Style="text-decoration:line-through; opacity:0.5">@b.Asked</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2"><strong>@b.Have</strong></MudText>
                            </MudStack>
                        }
                    </MudStack>
                }

                @* Bonus skills *@
                @if (_result.BonusSkills.Any())
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Bonus — you might not have thought of</MudText>
                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                            @foreach (var s in _result.BonusSkills)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">@s</MudChip>
                            }
                        </MudStack>
                    </MudStack>
                }

                @* Pitch *@
                @if (!string.IsNullOrEmpty(_result.Pitch))
                {
                    <MudPaper Class="pa-3 rounded-lg" Elevation="0" Style="background:var(--mud-palette-background-grey)">
                        <MudText Typo="Typo.body2" Style="font-style:italic">@_result.Pitch</MudText>
                    </MudPaper>
                }

                <MudDivider />

                @* Contact *@
                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_result.ContactCopy</MudText>
                    <SocialItems />
                </MudStack>

            </MudStack>
        </MudCardContent>
    </MudCard>
}

@if (_unavailable)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
        @Localizer["TailorUnavailable"]
    </MudAlert>
}

<style>
    .tailor-search .mud-input-outlined { border-radius: 12px !important; }
    .tailor-card { border-radius: 12px !important; overflow: hidden; animation: slide-up 0.4s ease; }
    .tailor-accent { height: 4px; }
    .tailor-accent.match-strong { background: linear-gradient(90deg, var(--mud-palette-success), var(--mud-palette-primary)); }
    .tailor-accent.match-partial { background: linear-gradient(90deg, var(--mud-palette-warning), var(--mud-palette-info)); }
    .tailor-accent.match-none    { background: linear-gradient(90deg, var(--mud-palette-error), var(--mud-palette-dark)); }
    @@keyframes slide-up {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private string _input = "";
    private bool _loading = false;
    private TailorResult? _result = null;
    private CancellationTokenSource _cts = new();
    private bool _unavailable = false;

    private string CaseAccentClass => _result?.Case switch
    {
        3 => "match-strong",
        2 => "match-partial",
        _ => "match-none"
    };

    private async Task Submit()
    {
        _unavailable = false;

        if (string.IsNullOrWhiteSpace(_input) || _loading) return;
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _result = null;
        _loading = true;
        StateHasChanged();
        try
        {
            _result = await TailorService.TailorAsync(_input.Trim(), _cts.Token);
        }
        catch (TailorUnavailableException)
        {
            _unavailable = true;
        }
        catch (OperationCanceledException) { }
        catch { _result = null; }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private void Reset()
    {
        _result = null;
        _input = "";
        _cts.Cancel();
    }

    public void Dispose() => _cts.Cancel();
}
