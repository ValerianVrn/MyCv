@using MyCv.UI.Wasm.Services
@using MyCv.UI.Wasm.Shared
@inject IStringLocalizer<MyCv.UI.Wasm.Resources.Components.Pages.Home> Localizer
@inject IConfiguration Configuration

<MudPaper Class="section-tinted py-8" Square="true" Elevation="0">
    <MudContainer Class="px-4 px-lg-20">
        <div class="d-flex d-md-none">
            <MudText Typo="Typo.h5" Align="Align.Left" Class="@Style.LargeBottomMargin">
                @Localizer["HomeHeader"]
                <MudText Color="Color.Primary" Typo="Typo.h5" Inline="true">Valérian</MudText>.
            </MudText>
        </div>
        <div class="d-none d-md-flex">
            <MudText Typo="Typo.h2" Align="Align.Left" Class="@Style.LargeBottomMargin">
                @Localizer["HomeHeader"]
                <MudText Color="Color.Primary" Typo="Typo.h2" Inline="true">Valérian</MudText>.
            </MudText>
        </div>
        <MudGrid Justify="Justify.Center">
            @* Terminal *@
            <MudItem xs="12" sm="9">
                <Terminal />
            </MudItem>
            @* Portrait *@
            <MudItem xs="8" sm="3" Class="d-flex align-center">
                <div class="portrait-badge-wrapper">
                    <MudImage Fluid="true" Src="images/portrait.webp" Alt="Portrait" Class="rounded-lg" />
                    <MudImage Src="images/badges/microsoft-certified-associate-badge.svg" Alt="Microsoft Certified badge" Class="microsoft-certified-badge" />
                </div>
            </MudItem>
            @* Introduction *@
            <MudItem xs="12" md="12">
                <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom>
                    @Localizer["HomeIntroduction"]
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    @Localizer["HomeSourceCode"] <MudLink Href="https://github.com/ValerianVrn/MyCv.git">GitHub</MudLink>.
                </MudText>
            </MudItem>
            @* Tailor AI *@
            <MudItem xs="12">
                <TailorSearch />
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudPaper>

<style>
    .portrait-badge-wrapper {
        position: relative;
        width: 100%;
    }

    .microsoft-certified-badge {
        position: absolute;
        left: -28px;
        bottom: -28px;
        width: clamp(56px, 7vw, 92px);
        height: auto;
        z-index: 1;
        filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.85))
            drop-shadow(0 4px 10px rgba(0, 0, 0, 0.3));
    }

    @@media (max-width: 599.98px) {
        .microsoft-certified-badge {
            left: -10px;
            bottom: -10px;
        }
    }
</style>
